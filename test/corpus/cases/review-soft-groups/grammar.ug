start S;
S --> P where (equals('a', 'a'), equals('b', 'b')):7;
S --> Q where (equals('a', 'a'), equals('a', 'b')):7;
S --> R where (equals('a', 'b'), equals('c', 'd')):7;
S --> T where (equals('a', 'a') | equals('a', 'b')):7;
S --> U where (equals('a', 'b') | equals('c', 'd')):7;
S --> V where equals('a', 'b'):3, equals('c', 'd'):4;
S --> W where equals('a', 'a'), (equals('a', 'b'), equals('c', 'd')):7;
S --> X where equals('a', 'b'), equals('c', 'c'):2;
S --> Y where (equals('a', 'b'):3, equals('c', 'd'):4):9;
S --> Z where equals('a', 'a'):5;
S --> M where equals('a', 'a'), (equals('a', 'b'):3, equals('c', 'd'):4);
S --> N where ((equals('a', 'b'):7));
P --> 'p';
Q --> 'q';
R --> 'r';
T --> 't';
U --> 'u';
V --> 'v';
W --> 'w';
X --> 'x';
Y --> 'y';
Z --> 'z';
M --> 'm';
N --> 'n';

# Equations over arithmetic expressions with scientific numbers.
# Ported from grammars-v4 arithmetic/arithmetic.g4 (commit 7df52be9).
# Copyright (c) 2013, Tom Everett. BSD licence (see NOTICE.md).
#
# The ANTLR rule 'expression' is a single left-recursive rule whose
# alternatives are ordered by precedence (^ over * / over + -), all left
# associative (ANTLR's default). Earley does not use alternative order, so the
# rule is split into one left-recursive level per precedence:
# expression (+ -), multiplying (* /), powering (^), primary.

start file_;
whitespace [ \r\n\t]+;

file_ --> equation* ;

equation --> expression relop expression ;

expression --> expression ('+' | '-') multiplying | multiplying ;

multiplying --> multiplying ('*' | '/') powering | powering ;

powering --> powering '^' primary | primary ;

primary --> '(' expression ')' | ('+' | '-')* atom ;

atom --> scientific | variable ;

scientific --> SCIENTIFIC_NUMBER ;

variable --> VARIABLE ;

relop --> '=' | '>' | '<' ;

VARIABLE --> [a-zA-Z_][a-zA-Z_0-9]* ;

SCIENTIFIC_NUMBER --> [0-9]+ (?:[.][0-9]+)? (?:[Ee][+\-]?[0-9]+)? ;
